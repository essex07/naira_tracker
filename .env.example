# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Use the publishable key (new projects) or the legacy anon key. Never use service_role here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key

# Used in confirmation-email redirects and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
