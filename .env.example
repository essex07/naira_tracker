# Server-only Supabase settings. Do not prefix these with NEXT_PUBLIC_.
# From Supabase: Project Settings -> API
SUPABASE_URL=

# Use the publishable key (new projects) or the legacy anon key. Never use
# the service_role / secret key here.
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=your_legacy_anon_key

# Used in confirmation-email redirects and route-guard redirects. Production
# requires HTTPS (localhost is allowed for local production checks).
SITE_URL=http://localhost:3000
